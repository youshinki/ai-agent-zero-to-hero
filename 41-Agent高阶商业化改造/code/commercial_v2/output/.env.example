# ===== 环境变量模板（交付时由客户自行填写）=====

# 运行环境：development / production
APP_ENV=production

# 大模型配置
API_KEY=your-api-key-here
BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# 服务配置
HOST=0.0.0.0
PORT=8000

# 检索与压缩参数
TOP_K=3
MAX_CONTEXT_TOKEN=1800
COMPRESS_THRESHOLD=20

# 日志级别（生产建议 WARNING）
LOG_LEVEL=WARNING
